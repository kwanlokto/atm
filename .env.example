FLASK_APP=app.py
FLASK_ENV=development
POSTGRES_USER=root
POSTGRES_PASSWORD=change-me
POSTGRES_SERVER=pgbouncer
POSTGRES_DB=docker_practice
POSTGRES_PORT=5432
POSTGRES_REAL_PORT=5434

JWT_SECRET=change-me-to-a-long-random-string

REDIS_HOST=redis
REDIS_PORT=6379

# Post-transaction events fan out through a Redis Stream consumer group.
TRANSACTION_EVENTS_STREAM=transaction.events
TRANSACTION_EVENTS_GROUP=transaction.workers

# ---- Cloud / free-tier deploy (override the discrete vars above) ----
# When set, these full connection strings win over the POSTGRES_*/REDIS_HOST
# parts. Set them in the host dashboard (Render/etc.), NOT in a committed file.
#   DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#   REDIS_URL=rediss://default:password@your-db.upstash.io:6379
# Restrict CORS to your frontend origin in production (default "*"):
#   CORS_ORIGINS=https://your-app.vercel.app
# API also runs the event consumer in-process when true (single-service hosting):
#   RUN_EMBEDDED_WORKER=true
